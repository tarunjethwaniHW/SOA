<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://wadl.dev.java.net/2009/02"
              xmlns:xs="http://www.w3.org/2001/XMLSchema"
              xmlns:tns="http://unified.mortgage.com/disbursement/wadl">
              
  <grammars>
    <xs:schema targetNamespace="http://unified.mortgage.com/disbursement/wadl" elementFormDefault="qualified">
      <xs:element name="DisbursementRequest">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="loanId" type="xs:long"/>
            <xs:element name="loanAmount" type="xs:double"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="DisbursementResponse">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="status" type="xs:string"/>
            <xs:element name="message" type="xs:string"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
    </xs:schema>
  </grammars>

  <resources base="http://localhost:8085/api">
    <resource path="disbursements">
      <method name="POST" id="processDisbursement">
        <request>
          <representation mediaType="application/json" element="tns:DisbursementRequest"/>
        </request>
        <response status="200">
          <representation mediaType="application/json" element="tns:DisbursementResponse"/>
        </response>
      </method>
    </resource>
  </resources>
</application>
