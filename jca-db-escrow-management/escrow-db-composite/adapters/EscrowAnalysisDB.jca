<?xml version="1.0" encoding="UTF-8"?>
<adapter-config name="EscrowAnalysisDB"
                adapter="db"
                wsdlLocation="EscrowAnalysisDB.wsdl"
                xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">

    <!-- ================================================================== -->
    <!-- Database Adapter - Escrow Analyses                                 -->
    <!-- Provides CRUD operations for ESCROW_ANALYSES table                  -->
    <!-- Connection: eis/DB/EscrowServicingDS                                      -->
    <!-- ================================================================== -->

    <connection-factory location="eis/DB/EscrowServicingDS"
                        UIConnectionName="EscrowServicingDS"
                        adapterRef=""/>

    <!-- Insert Escrow analysis -->
    <endpoint-interaction portType="EscrowAnalysisDB_ptt" operation="insertEscrowAnalysis">
        <interaction-spec className="oracle.tip.adapter.db.DBWriteInteractionSpec">
            <property name="DescriptorName" value="EscrowAnalysisDB.EscrowAnalysis"/>
            <property name="DmlType" value="INSERT"/>
            <property name="MappingsMetaDataURL" value="EscrowAnalysisDB-or-mappings.xml"/>
            <property name="GetActiveUnitOfWork" value="false"/>
        </interaction-spec>
    </endpoint-interaction>

    <!-- Select Escrow analysis by Escrow ID -->
    <endpoint-interaction portType="EscrowAnalysisDB_ptt" operation="selectEscrowAnalysisByAccount">
        <interaction-spec className="oracle.tip.adapter.db.DBReadInteractionSpec">
            <property name="DescriptorName" value="EscrowAnalysisDB.EscrowAnalysis"/>
            <property name="QueryObjectName" value="selectByEscrowAccountId"/>
            <property name="MappingsMetaDataURL" value="EscrowAnalysisDB-or-mappings.xml"/>
            <property name="GetActiveUnitOfWork" value="false"/>
            <property name="MaxTransactionSize" value="100"/>
        </interaction-spec>
    </endpoint-interaction>

    <!-- Stored Procedure: Run Analysis Assessment -->
    <endpoint-interaction portType="EscrowAnalysisDB_ptt" operation="runEscrowAnalysis">
        <interaction-spec className="oracle.tip.adapter.db.DBStoredProcedureInteractionSpec">
            <property name="SchemaName" value="ESCROWSVC"/>
            <property name="PackageName" value="ANALYSIS_PKG"/>
            <property name="ProcedureName" value="RUN_ESCROW_ANALYSIS"/>
            <property name="GetActiveUnitOfWork" value="false"/>
        </interaction-spec>
    </endpoint-interaction>

</adapter-config>
