<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="HelocApprovalProcess"
                  targetNamespace="http://xmlns.oracle.com/HelocOrchestration/HelocApprovalProcess"
                  xmlns:tns="http://xmlns.oracle.com/HelocOrchestration/HelocApprovalProcess"
                  xmlns:types="http://xmlns.oracle.com/HelocOrchestration/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

  <wsdl:types>
    <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:import namespace="http://xmlns.oracle.com/HelocOrchestration/types" schemaLocation="HelocWorkflow.xsd" />
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="HelocApprovalRequestMessage">
    <wsdl:part name="payload" element="types:HelocApplicationRequest"/>
  </wsdl:message>
  <wsdl:message name="HelocApprovalResponseMessage">
    <wsdl:part name="payload" element="types:HelocApplicationResponse"/>
  </wsdl:message>
  <wsdl:message name="SanctionListFaultMessage">
    <wsdl:part name="fault" element="types:HelocFaultDetail"/>
  </wsdl:message>

  <wsdl:portType name="HelocApprovalProcess">
    <wsdl:operation name="initiateHeloc">
      <wsdl:input message="tns:HelocApprovalRequestMessage"/>
      <wsdl:output message="tns:HelocApprovalResponseMessage"/>
      <wsdl:fault name="sanctionFault" message="tns:SanctionListFaultMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="HelocApprovalProcessBinding" type="tns:HelocApprovalProcess">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="initiateHeloc">
      <soap:operation soapAction="initiateHeloc"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
      <wsdl:fault name="sanctionFault">
        <soap:fault name="sanctionFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="helocapproval_client_ep">
    <wsdl:port name="HelocApprovalProcess_pt" binding="tns:HelocApprovalProcessBinding">
      <soap:address location="http://localhost:10081/soap/HelocApprovalProcess"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
