<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="EscrowHolderDB"
                  targetNamespace="http://xmlns.oracle.com/EscrowServicing/adapter/db/EscrowHolderDB"
                  xmlns:tns="http://xmlns.oracle.com/EscrowServicing/adapter/db/EscrowHolderDB"
                  xmlns:types="http://xmlns.oracle.com/EscrowServicing/EscrowDBProcess/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:jca="http://xmlns.oracle.com/pcbpel/wsdl/jca/"
                  xmlns:plnk="http://docs.oasis-open.org/wsbpel/2.0/plnktype">

    <!-- Import XSD Types -->
    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/EscrowServicing/EscrowDBProcess/types"
                        schemaLocation="../EscrowDBTypes.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <!-- Messages for DB Operations -->
    <wsdl:message name="EscrowHolderCollectionMessage">
        <wsdl:part name="EscrowHolderCollection" element="types:EscrowHolderCollection"/>
    </wsdl:message>
    <wsdl:message name="EscrowHolderSelectByTaxIdMessage">
        <wsdl:part name="taxId" type="xsd:string" xmlns:xsd="http://www.w3.org/2001/XMLSchema"/>
    </wsdl:message>

    <!-- PortType - Database Adapter Operations -->
    <wsdl:portType name="EscrowHolderDB_ptt">
        <wsdl:operation name="insertEscrowHolder">
            <wsdl:documentation>
                Insert new escrow holder record.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: INSERT
                DescriptorName: EscrowHolderDB.EscrowHolder
            </wsdl:documentation>
            <wsdl:input message="tns:EscrowHolderCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="selectEscrowHolderByTaxId">
            <wsdl:documentation>
                Select escrow holder by TAX_ID.
                JCA: oracle.tip.adapter.db.DBReadInteractionSpec
                QueryObjectName: selectByTaxId
                DescriptorName: EscrowHolderDB.EscrowHolder
            </wsdl:documentation>
            <wsdl:input message="tns:EscrowHolderSelectByTaxIdMessage"/>
            <wsdl:output message="tns:EscrowHolderCollectionMessage"/>
        </wsdl:operation>

        <wsdl:operation name="updateEscrowHolderPaymentStanding">
            <wsdl:documentation>
                Update escrow holder payment standing score.
                JCA: oracle.tip.adapter.db.DBWriteInteractionSpec
                DmlType: UPDATE
                DescriptorName: EscrowHolderDB.EscrowHolder
            </wsdl:documentation>
            <wsdl:input message="tns:EscrowHolderCollectionMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <!-- JCA Binding -->
    <wsdl:binding name="EscrowHolderDB_binding" type="tns:EscrowHolderDB_ptt">
        <jca:binding/>
        <wsdl:operation name="insertEscrowHolder">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
        <wsdl:operation name="selectEscrowHolderByTaxId">
            <jca:operation/>
            <wsdl:input/>
            <wsdl:output/>
        </wsdl:operation>
        <wsdl:operation name="updateEscrowHolderPaymentStanding">
            <jca:operation/>
            <wsdl:input/>
        </wsdl:operation>
    </wsdl:binding>

    <!-- Service -->
    <wsdl:service name="EscrowHolderDB_service">
        <wsdl:port name="EscrowHolderDB_pt" binding="tns:EscrowHolderDB_binding">
            <jca:address location="eis/DB/EscrowServicingDS"/>
        </wsdl:port>
    </wsdl:service>

    <!-- Partner Link Type -->
    <plnk:partnerLinkType name="EscrowHolderDB_plt">
        <plnk:role name="EscrowHolderDBProvider" portType="tns:EscrowHolderDB_ptt"/>
    </plnk:partnerLinkType>

</wsdl:definitions>
