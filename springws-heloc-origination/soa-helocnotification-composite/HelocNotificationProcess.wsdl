<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="HelocNotificationProcess"
                  targetNamespace="http://xmlns.oracle.com/HelocOrchestration/HelocNotificationProcess"
                  xmlns:tns="http://xmlns.oracle.com/HelocOrchestration/HelocNotificationProcess"
                  xmlns:types="http://xmlns.oracle.com/HelocOrchestration/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

  <wsdl:types>
    <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
      <xsd:import namespace="http://xmlns.oracle.com/HelocOrchestration/types" schemaLocation="../heloc-service-soa/HelocWorkflow.xsd" />
    </xsd:schema>
  </wsdl:types>

  <wsdl:message name="HelocNotificationRequestMessage">
    <wsdl:part name="payload" element="types:HelocNotificationRequest"/>
  </wsdl:message>
  <wsdl:message name="HelocNotificationResponseMessage">
    <wsdl:part name="payload" element="types:HelocNotificationResponse"/>
  </wsdl:message>

  <wsdl:portType name="HelocNotificationProcess">
    <wsdl:operation name="processHelocNotification">
      <wsdl:input message="tns:HelocNotificationRequestMessage"/>
      <wsdl:output message="tns:HelocNotificationResponseMessage"/>
    </wsdl:operation>
  </wsdl:portType>

  <wsdl:binding name="HelocNotificationProcessBinding" type="tns:HelocNotificationProcess">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="processHelocNotification">
      <soap:operation soapAction="processHelocNotification"/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>

  <wsdl:service name="helocnotificationprocess_client_ep">
    <wsdl:port name="HelocNotificationProcess_pt" binding="tns:HelocNotificationProcessBinding">
      <soap:address location="http://localhost:10086/soap/HelocNotificationProcess"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>
