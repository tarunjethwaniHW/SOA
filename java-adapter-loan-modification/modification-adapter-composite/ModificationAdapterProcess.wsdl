<?xml version="1.0" encoding="UTF-8"?>
<wsdl:definitions name="ModificationAdapterProcess"
                  targetNamespace="http://xmlns.oracle.com/LoanModification/ModificationAdapterProcess"
                  xmlns:tns="http://xmlns.oracle.com/LoanModification/ModificationAdapterProcess"
                  xmlns:types="http://xmlns.oracle.com/LoanModification/types"
                  xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
                  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/">

    <wsdl:types>
        <xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
            <xsd:import namespace="http://xmlns.oracle.com/LoanModification/types"
                        schemaLocation="ModificationAdapterProcess.xsd"/>
        </xsd:schema>
    </wsdl:types>

    <wsdl:message name="ModificationProcessRequestMessage">
        <wsdl:part name="payload" element="types:ModificationProcessRequest"/>
    </wsdl:message>
    <wsdl:message name="ModificationProcessResponseMessage">
        <wsdl:part name="payload" element="types:ModificationProcessResponse"/>
    </wsdl:message>
    <wsdl:message name="ProcessingFaultMessage">
        <wsdl:part name="fault" element="types:ModificationFaultDetail"/>
    </wsdl:message>

    <wsdl:portType name="ModificationAdapterProcess">
        <wsdl:operation name="processModification">
            <wsdl:input message="tns:ModificationProcessRequestMessage"/>
            <wsdl:output message="tns:ModificationProcessResponseMessage"/>
            <wsdl:fault name="processingFault" message="tns:ProcessingFaultMessage"/>
        </wsdl:operation>
    </wsdl:portType>

    <wsdl:binding name="ModificationAdapterProcessBinding" type="tns:ModificationAdapterProcess">
        <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
        <wsdl:operation name="processModification">
            <soap:operation soapAction="processModification"/>
            <wsdl:input>
                <soap:body use="literal"/>
            </wsdl:input>
            <wsdl:output>
                <soap:body use="literal"/>
            </wsdl:output>
            <wsdl:fault name="processingFault">
                <soap:fault name="processingFault" use="literal"/>
            </wsdl:fault>
        </wsdl:operation>
    </wsdl:binding>

    <wsdl:service name="modificationadapter_client_ep">
        <wsdl:port name="ModificationAdapterProcess_pt" binding="tns:ModificationAdapterProcessBinding">
            <soap:address location="http://localhost:12080/soap/ModificationAdapterProcess"/>
        </wsdl:port>
    </wsdl:service>

</wsdl:definitions>
