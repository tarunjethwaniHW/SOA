<adapter-config name="ConsumeVerificationResponse" adapter="jms" wsdlLocation="ConsumeVerificationResponse.wsdl" xmlns="http://platform.integration.oracle/blocks/adapter/fw/metadata">
  <connection-factory UIConnectionName="LocalWebLogic" location="eis/wls/Queue" adapterRef=""/>
  <endpoint-activation portType="Consume_Message_ptt" operation="Consume_Message">
    <activation-spec className="oracle.tip.adapter.jms.inbound.JmsConsumeActivationSpec">
      <property name="DestinationName" value="jms/VerificationResponseQueue"/>
      <property name="UseMessageListener" value="true"/>
      <property name="PayloadType" value="TextMessage"/>
    </activation-spec>
  </endpoint-activation>
</adapter-config>
